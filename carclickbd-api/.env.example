NODE_ENV=production
PORT=5000
DATABASE_URL=

FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com

# Persistent uploads folder. On Hostinger this is commonly under the account
# home directory, for example: /home/u123456789/carclickbd-uploads
UPLOAD_ROOT=/home/uYOUR_ACCOUNT_ID/carclickbd-uploads

BDGATE_API_KEY=
BDGATE_API_BASE_URL=https://api.bdgate.net/api
BDGATE_WEBHOOK_SECRET=

JWT_ACCESSTOKEN_SECRET=
JWT_REFRESHTOKEN_SECRET=
JWT_ACCESSTOKEN_EXPIRE=7d
JWT_REFRESH_EXPIRES_IN=30d
