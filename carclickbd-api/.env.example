NODE_ENV=production
PORT=5000
DATABASE_URL=

FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com

# Persistent uploads folder. On Hostinger this is commonly under the account
# home directory, for example: /home/u123456789/carclickbd-uploads
UPLOAD_ROOT=/home/uYOUR_ACCOUNT_ID/carclickbd-uploads

# Auction sheet files are stored outside the application source.
AUCTION_SHEET_ROOT=/home/uYOUR_ACCOUNT_ID/carclickbd-uploads/auction-sheets
AUCTION_SHEET_PRICE_BDT=800

BDGATE_API_KEY=
BDGATE_API_BASE_URL=https://api.bdgate.net/api
BDGATE_WEBHOOK_SECRET=

# JPCenter True Report access code (keep this only on the backend)
JPCENTER_API_CODE=
JPCENTER_API_BASE_URL=https://jpcenter.ru/api/report

# Facebook Page auto-posting (keep the token only on the backend)
FACEBOOK_PAGE_ID=1098591320014561
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v26.0
FACEBOOK_AUTO_POST=true

JWT_ACCESSTOKEN_SECRET=
JWT_REFRESHTOKEN_SECRET=
JWT_ACCESSTOKEN_EXPIRE=7d
JWT_REFRESH_EXPIRES_IN=30d
